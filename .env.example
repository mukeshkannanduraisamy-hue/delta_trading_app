# Copy to .env and fill in. NEVER commit the real .env — it is gitignored.
#
# Delta Exchange India — DEMO (testnet) API credentials.
# Create them at https://demo.delta.exchange. Demo keys work ONLY against the
# testnet base URL; production keys will not authenticate here.
DELTA_API_KEY=your_testnet_api_key
DELTA_API_SECRET=your_testnet_api_secret

# ---------------------------------------------------------------------------
# Execution mode: LIVE ONLY.
#
# Paper (simulated-fill) mode was removed from the code. This key is a label —
# changing it does nothing, and any value other than live_demo prints a warning
# at startup. Starting the engine places REAL orders on the Delta TESTNET demo
# book. There is no dry run.
#
# Signed requests are hardcoded to the testnet base in delta_client.py, so this
# cannot reach a real-money book. The order flow is genuine; the money is not.
# ---------------------------------------------------------------------------
EXECUTION_MODE=live_demo

# Engine
ENGINE_ASSET=BTC                 # BTC | ETH
ENGINE_POLL_SECONDS=0.5          # manage/stop-check cadence (0.25s floor)
ENGINE_CONTRACTS=1               # contracts per trade — START AT 1
ENGINE_AUTOSTART=false           # true = arm the engine on boot. Leave false.
ENGINE_MAX_OPEN=8                # hard cap on concurrent open positions
ENGINE_MAX_HOLD_BARS=60          # time-based exit, in bars
ENGINE_COOLDOWN_BARS=5           # post-close cooldown per (strategy, direction)
ENGINE_ENABLED_STRATEGIES=none   # "all", "none", or a comma-separated slug list

# Entry order type (market crosses the spread; limit rests near mid)
ENTRY_ORDER_TYPE=limit           # market | limit
LIMIT_ANCHOR=mid                 # mid | bid | ask
LIMIT_OFFSET_TICKS=0
LIMIT_TTL_BARS=2                 # cancel an unfilled limit after N bars

# Safety
ENGINE_MIN_HOURS_TO_EXPIRY=2     # never buy an option closer than this to settlement
ENGINE_ORPHAN_POLICY=adopt       # adopt | flatten | report — untracked exchange positions
ENGINE_ADOPT_SL_PCT=0.30         # stop applied to an adopted position
ENGINE_ADOPT_RR=1.5              # reward:risk applied to an adopted position
ENGINE_FLATTEN_ON_SHUTDOWN=true  # close live positions when the app stops
ENGINE_ACCOUNT_SYNC_SECONDS=15   # how often to pull balances/positions/orders

# Display baseline for the session equity line (not a wallet)
SESSION_EQUITY_BASE=10000

# ---------------------------------------------------------------------------
# Optional: LLM-driven strategy (disabled if AI_API_KEY is blank)
# ---------------------------------------------------------------------------
AI_API_KEY=
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=z-ai/glm-5.2
AI_FALLBACK_MODELS=abacusai/dracarys-llama-3.1-70b-instruct
AI_TEMPERATURE=0.2
AI_REFRESH_SECONDS=300
AI_MIN_CONFIDENCE=0.65
AI_TIMEOUT_SECONDS=25
