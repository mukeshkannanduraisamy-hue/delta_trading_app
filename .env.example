# ===========================================================================
# DELTA TRADING APP — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and set your values.
# NEVER commit your real .env file containing live API keys to GitHub.
# ===========================================================================

# Delta Exchange API Credentials
# Create keys at https://www.delta.exchange or https://demo.delta.exchange
DELTA_API_KEY=your_delta_api_key_here
DELTA_API_SECRET=your_delta_api_secret_here

# Execution Mode: "paper" (internal simulation) or "live" (real Delta API orders)
EXECUTION_MODE=paper

# Strategy Engine Configuration
ENGINE_ASSET=BTC                 # BTC | ETH
ENGINE_POLL_SECONDS=1.0          # Strategy evaluation loop interval (seconds, min 0.25)
ENGINE_CONTRACTS=1               # Contracts per trade order
ENGINE_AUTOSTART=false           # true = automatically arm engine on server boot

# Order Execution Settings
ENTRY_ORDER_TYPE=market          # market | limit
LIMIT_ANCHOR=mid                 # mid | bid | ask
LIMIT_OFFSET_TICKS=0
LIMIT_TTL_BARS=2                 # Cancel unfilled limit after N bars

# Safety & Quantitative Options Risk Bounds
MIN_HOURS_TO_EXPIRY=2.0          # Do not trade options with < 2.0 hours to settlement
IV_SKIP_THRESHOLD=85.0           # Auto-skip BUY options if IV Rank > 85%
FLATTEN_ON_SHUTDOWN=true         # Automatically flatten open positions on server stop
ACCOUNT_SYNC_SECONDS=15          # Sync balance & margin from exchange every N seconds

# Optional: AI Model Configuration (NVIDIA NIM API)
AI_API_KEY=
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=z-ai/glm-5.2
AI_TEMPERATURE=0.2
AI_REFRESH_SECONDS=300
AI_MIN_CONFIDENCE=0.65
